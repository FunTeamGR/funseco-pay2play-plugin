# Copy the keys you need into the root .env (Laravel only loads that file).
# Billing: needs a United server account (else players are told and nothing is charged).
# true lets players pay coppers for a replay
PAY2PLAY_REPLAY_ENABLED=true
# true lets players pay coppers to skip the map
PAY2PLAY_SKIP_ENABLED=true
# VotePay: true pays coppers for karma votes
VOTEPAY_ENABLED=true
